# CampusSync AI Environment Configuration
# Deen Dayal Upadhyaya Gorakhpur University (DDUGU) Hackathon 2026

PROJECT_NAME=CampusSync AI
VERSION=1.0.0

# Database Configuration
# Local SQLite Default (out-of-the-box):
DATABASE_URL=sqlite:///./campussync.db

# Docker / Production PostgreSQL Configuration:
# DATABASE_URL=postgresql+psycopg2://campussync:campussync_secret_2026@localhost:5432/campussync_db
# Neon PostgreSQL Hosted Example:
# DATABASE_URL=postgresql://neondb_owner:password@ep-cool-frost-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Supabase PostgreSQL Hosted Example:
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_USER=campussync
POSTGRES_PASSWORD=campussync_secret_2026
POSTGRES_DB=campussync_db

# Frontend Production Configuration (Vercel)
# VITE_API_BASE_URL=https://your-backend-api.onrender.com/api

# Security & Authentication
JWT_SECRET=campussync_super_secret_jwt_key_2026_ddugu_hackathon
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Configuration (Optional: built-in intelligent rule-based engine operates automatically when key is omitted)
GEMINI_API_KEY=

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

